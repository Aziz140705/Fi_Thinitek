<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8">

    <!-- ===== CONTENU PRINCIPAL = ACCUEIL POUR TOUS ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <org.maplibre.android.maps.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            tools:background="#B7D8F5" />

        <View
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/bg_map_top_fade"
            android:clickable="false"
            android:focusable="false" />

        <!-- Barre supérieure - btnRetour devient btnMenu ☰ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="#FAFFFFFF"
            app:cardCornerRadius="22dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/baby_blue"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <!-- BOUTON MENU DRAWER -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardBackgroundColor="#F2F4F7"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="☰"
                        android:textColor="#1E293B"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bangers"
                            android:text="Fi Thnitek"
                            android:textColor="@color/pocket_red"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRolePill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_pill_yellow"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Accueil"
                            android:textColor="#1A1A1A"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBienvenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Bienvenue !"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnProfil"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    app:cardBackgroundColor="@color/baby_blue"
                    app:cardCornerRadius="21dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#90C3F0"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Profil"
                        android:src="@drawable/ic_person"
                        app:tint="#0F4C81" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvMapInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="96dp"
            android:background="@drawable/bg_map_info"
            android:clickable="false"
            android:elevation="6dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Trajet compatible"
            android:textColor="#15803D"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Contrôles carte -->
        <LinearLayout
            android:id="@+id/layoutZoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="132dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnZoomIn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/baby_blue"
                app:strokeWidth="1.5dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="+" android:textColor="#0F172A" android:textSize="24sp" android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnZoomOut"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/baby_blue"
                app:strokeWidth="1.5dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="-" android:textColor="#0F172A" android:textSize="24sp" android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnLocaliser"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/baby_blue"
                app:strokeWidth="1.5dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_my_location" app:tint="@color/pocket_red" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAgrandir"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/sunshine_yellow"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/baby_blue"
                app:strokeWidth="1.5dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="⛶" android:textColor="#0F172A" android:textSize="22sp" android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Panneau Accueil -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPassengerRide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="28dp"
            app:cardElevation="14dp"
            app:strokeColor="@color/baby_blue"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Où souhaitez-vous aller ?" android:textColor="#0F172A" android:textSize="17sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Recherchez un trajet partagé en Tunisie" android:textColor="#64748B" android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardBackgroundColor="@color/sunshine_yellow"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_car" app:tint="#1A1A1A" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDepart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Point de départ"
                    app:boxBackgroundColor="#F4F9FD"
                    app:boxBackgroundMode="filled"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/pocket_red"
                    app:boxStrokeWidth="1dp"
                    app:startIconDrawable="@drawable/ic_depart_pin"
                    app:startIconTint="#0F4C81">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDepart" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:singleLine="true" android:textColor="#0F172A" android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDestination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Destination"
                    app:boxBackgroundColor="#F4F9FD"
                    app:boxBackgroundMode="filled"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/pocket_red"
                    app:boxStrokeWidth="1dp"
                    app:startIconDrawable="@drawable/ic_destination_pin"
                    app:startIconTint="@color/pocket_red">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDestination" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:singleLine="true" android:textColor="#0F172A" android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRechercher"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/pocket_red"
                    android:text="Rechercher un trajet"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_search_magnifier"
                    app:iconTint="#FFFFFF" />

                <!-- BOUTON PASSER CONDUCTEUR -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPasserConducteur"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/sunshine_yellow"
                    android:text="Passer à un compte conducteur 🚗"
                    android:textAllCaps="false"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp" />

                <View android:layout_width="match_parent" android:layout_height="1.5dp" android:layout_marginTop="14dp" android:layout_marginBottom="6dp" android:background="@color/baby_blue" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMesReservations" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Mes réservations" android:textAllCaps="false" android:textColor="#475569" android:textSize="13sp" android:textStyle="bold" app:icon="@drawable/ic_ticket_history" app:iconTint="#475569" />
                    <View android:layout_width="1.5dp" android:layout_height="22dp" android:background="@color/baby_blue" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnDeconnexion" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Déconnexion" android:textAllCaps="false" android:textColor="@color/pocket_red" android:textSize="13sp" android:textStyle="bold" app:icon="@drawable/ic_logout" app:iconTint="@color/pocket_red" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="4dp"
            android:background="#C0FFFFFF"
            android:clickable="false"
            android:focusable="false"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="© OpenStreetMap contributors © CARTO"
            android:textColor="#666666"
            android:textSize="9sp" />
    </FrameLayout>

    <!-- ===== DRAWER - Liste des fonctionnalités ===== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        app:headerLayout="@layout/nav_header_home"
        app:menu="@menu/drawer_menu"
        app:itemIconTint="@color/pocket_red"
        app:itemTextColor="#0F172A" />

</androidx.drawerlayout.widget.DrawerLayout>