<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fi Thnitek 🚗"
            android:textColor="#247A4B"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/tvBienvenue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bienvenue, Passager !"
            android:textColor="#333333"
            android:textSize="20sp"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Où souhaitez-vous aller aujourd'hui ?"
            android:textColor="#666666"
            android:textSize="15sp"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/etDepart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:hint="📍 Point de départ"
            android:inputType="textCapWords"
            android:padding="12dp"/>

        <EditText
            android:id="@+id/etDestination"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="🏁 Destination"
            android:inputType="textCapWords"
            android:padding="12dp"/>

        <Button
            android:id="@+id/btnRechercher"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Rechercher un trajet"
            android:textColor="#FFFFFF"
            android:backgroundTint="#247A4B"/>

        <Button
            android:id="@+id/btnMesReservations"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Mes réservations"
            android:textColor="#247A4B"
            android:backgroundTint="#E4EFE6"/>

        <Button
            android:id="@+id/btnDeconnexion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="Se déconnecter"
            android:textColor="#B3261E"
            android:backgroundTint="#FDE8E7"/>

    </LinearLayout>
</ScrollView>
