<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F9F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fi Thnitek"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#247A4B"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Mot de passe oublié ?"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Entrez votre adresse e-mail pour recevoir un lien de réinitialisation."
            android:textSize="15sp"
            android:textColor="#666666"
            android:gravity="center" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:hint="Adresse e-mail"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnEnvoyer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Envoyer le lien"
            android:textColor="#FFFFFF"
            android:backgroundTint="#247A4B" />

        <TextView
            android:id="@+id/tvRetourLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Retour à la connexion"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#247A4B"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
