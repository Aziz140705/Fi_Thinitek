<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F9F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Logo textuel -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fi Thnitek"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#247A4B"
            android:gravity="center" />

        <!-- Titre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Vérification du code"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center" />

        <!-- Explication -->
        <TextView
            android:id="@+id/tvEmailInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Entrez le code à 6 chiffres envoyé par email."
            android:textSize="15sp"
            android:textColor="#666666"
            android:gravity="center" />

        <!-- Code reçu dans Gmail -->
        <EditText
            android:id="@+id/etCode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="30dp"
            android:hint="Code à 6 chiffres"
            android:inputType="number"
            android:maxLength="6"
            android:singleLine="true"
            android:gravity="center"
            android:textSize="22sp"
            android:letterSpacing="0.15"
            android:padding="12dp" />

        <!-- Vérifier le code -->
        <Button
            android:id="@+id/btnVerifier"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Vérifier le code"
            android:textColor="#FFFFFF"
            android:backgroundTint="#247A4B" />

        <!-- Retour -->
        <TextView
            android:id="@+id/tvRetour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Retour"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#247A4B"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
