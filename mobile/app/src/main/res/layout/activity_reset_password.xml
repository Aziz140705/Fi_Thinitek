<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F9F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Nom de l'application -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fi Thnitek"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#247A4B"
            android:gravity="center" />

        <!-- Titre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Nouveau mot de passe"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Votre code a été vérifié. Choisissez un nouveau mot de passe."
            android:textColor="#666666"
            android:textSize="15sp"
            android:gravity="center" />

        <!-- Nouveau mot de passe -->
        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="30dp"
            android:hint="Nouveau mot de passe"
            android:inputType="textPassword"
            android:padding="12dp" />

        <!-- Confirmation -->
        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="Confirmer le mot de passe"
            android:inputType="textPassword"
            android:padding="12dp" />

        <!-- Enregistrer -->
        <Button
            android:id="@+id/btnResetPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="Modifier le mot de passe"
            android:textColor="#FFFFFF"
            android:backgroundTint="#247A4B" />

    </LinearLayout>
</ScrollView>
